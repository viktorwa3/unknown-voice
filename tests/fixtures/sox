#!/usr/bin/env bash
# Stub for sox. Logs argv to $STUB_LOG and writes a tiny valid WAV to the last
# non-flag arg that looks like an output path (*.wav). No audio processing.
echo "sox $*" >> "${STUB_LOG:-/dev/null}"

# --version short-circuit (autodetect / sanity)
case "${1:-}" in
    --version|--help) echo "sox: stub v0"; exit 0 ;;
esac

# find output: last token ending in .wav
out=""
for a in "$@"; do
    case "$a" in
        *.wav) out="$a" ;;
    esac
done

if [[ -n "$out" ]]; then
    # 44-byte canonical WAV header, 0 samples. enough for downstream stubs.
    {
        printf 'RIFF'
        printf '\044\000\000\000'          # ChunkSize = 36
        printf 'WAVEfmt '
        printf '\020\000\000\000'          # Subchunk1Size = 16
        printf '\001\000\001\000'          # PCM, mono
        printf '\104\254\000\000'          # 44100 Hz
        printf '\210\130\001\000'          # byte rate
        printf '\002\000\020\000'          # block align, 16 bit
        printf 'data'
        printf '\000\000\000\000'          # data size = 0
    } > "$out"
fi
exit 0
