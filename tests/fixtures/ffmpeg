#!/usr/bin/env bash
# Stub for ffmpeg. Logs argv, writes a tiny valid WAV to the last positional
# arg (ffmpeg output is always last). Ignores all -flags.
echo "ffmpeg $*" >> "${STUB_LOG:-/dev/null}"

case "${1:-}" in
    -version|--help) echo "ffmpeg stub v0"; exit 0 ;;
esac

# output = last arg
out="${*: -1}"
if [[ -n "$out" && "$out" != -* ]]; then
    printf 'RIFF\044\000\000\000WAVEfmt \020\000\000\000\001\000\001\000\104\254\000\000\210\130\001\000\002\000\020\000data\000\000\000\000' > "$out"
fi
exit 0
